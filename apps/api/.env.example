# Copy to .env and fill in real values before deploying.
# See app/security.py and app/db.py — in ENVIRONMENT=production, the app
# refuses to start at all if JWT_SECRET or DATABASE_DSN aren't set here.

# development | production — controls whether insecure dev fallbacks for
# JWT_SECRET/DATABASE_DSN are allowed. Docker's own default is "production"
# (see Dockerfile) — override only for local, non-containerized dev.
ENVIRONMENT=development

# Postgres connection string for the app_runtime role (NOT the table-owner
# role — RLS is bypassed for owners/superusers, so using the wrong role
# here silently defeats every tenant-isolation guarantee in this system).
DATABASE_DSN=postgresql://app_runtime:CHANGE_ME@localhost:5432/audit_os

# A long, random, secret string — used to sign every JWT issued by this
# system. Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME

# Comma-separated list of origins allowed to call this API from a browser
# (CORS). Must include your actual deployed frontend's origin, or every
# browser request from it will be blocked with no server-side error at all
# (this is enforced by the browser itself, not by this API).
ALLOWED_ORIGINS=https://your-frontend-domain.example.com
