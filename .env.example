# Copy to .env at the repo root before running `docker compose up`.
# docker-compose.yml refuses to start any service without these set
# (Compose's ${VAR:?message} syntax) — no insecure defaults are baked in
# at this layer, unlike the app's own dev-only fallbacks.

POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
APP_RUNTIME_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ALLOWED_ORIGINS=http://localhost:8080

# Generate real values with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
